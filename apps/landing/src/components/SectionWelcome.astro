---
import SectionHeader from './ui/SectionHeader.astro';
import Button from './ui/Button.astro';
import { welcome } from '../data/home';
---
<section id="join" class="section container" aria-labelledby="join-title">
  <SectionHeader id="join-title" align="split" leadBelow title={welcome.title} lead={welcome.lead} />
  <ul class="people" role="list" data-stagger data-each=".12">
    {welcome.people.map((p, i) => (
      <li class:list={['person', i === 0 && 'person--ink']}>
        <p class="person__n">0{i + 1}</p>
        <h3 class="person__who">{p.who}</h3>
        <p class="person__text">{p.text}</p>
        <div class="person__cta"><Button href={p.cta.href} variant={i === 0 ? 'light' : 'solid'}>{p.cta.label}</Button></div>
      </li>
    ))}
  </ul>
</section>
<style>
  /* the lead runs on one long line instead of wrapping at the header's usual width */
  :global(#join .sh__lead) { max-width: none; }
  .people { margin-top: 56px; display: grid; gap: 24px; }
  .person { background: var(--cream); padding: 40px 32px; display: grid; gap: 12px; align-content: start; transition: transform .7s cubic-bezier(.16,1,.3,1); }
  .person:hover { transform: translateY(-6px); }
  .person--ink { background: var(--brand); color: var(--white); }
  .person__n { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--brand-ink); }
  .person--ink .person__n { color: var(--on-brand-muted); }
  .person__who { font-size: var(--fs-h3); line-height: var(--lh-tight); letter-spacing: var(--track-l); }
  .person__text { font-size: .95rem; line-height: 1.55; color: var(--brand-ink); max-width: 38ch; }
  .person--ink .person__text { color: var(--on-brand-muted); }
  .person__cta { margin-top: 16px; }
  /* three across, then two wider cards, so no row is left with a gap */
  @media (min-width: 900px) {
    .people { grid-template-columns: repeat(6, 1fr); }
    .person { grid-column: span 2; padding: 48px 40px; grid-template-rows: auto auto 1fr auto; }
    .person:nth-child(n + 4) { grid-column: span 3; }
  }
  @media (max-width: 600px) { .person { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }
</style>
