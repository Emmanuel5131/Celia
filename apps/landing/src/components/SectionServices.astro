---
import SectionHeader from './ui/SectionHeader.astro';
import ServiceCard from './ServiceCard.astro';
import { services, servicesIntro } from '../data/home';
---
<section id="method" class="section" aria-labelledby="services-title">
  <div class="container">
    <SectionHeader id="services-title" align="split" leadBelow wideLead title={servicesIntro.title} lead={servicesIntro.lead} />
    <p class="source">Source: <a href={servicesIntro.source.href} rel="noopener">{servicesIntro.source.label}</a></p>
    <ul class="cards" role="list" data-stagger data-each=".12" data-start="top 95%">
      {services.map((s, i) => <li><ServiceCard id={`service-${s.slug}`} index={i + 1} kicker={s.kicker} title={s.title} text={s.description} art={s.art} tags={s.tags} link={s.link} /></li>)}
    </ul>
  </div>
</section>
<style>
  .source { margin-top: 24px; font-size: var(--fs-small); color: var(--brand-ink); max-width: 44rem; }
  .source a { text-decoration: underline; text-underline-offset: 3px; }
  /* a wide row gap, so on a phone or a tablet one card's tags do not run into the next card's picture */
  /* the cards sit on the page and scroll with it: one column on a phone, two on a tablet, all four on a desktop. Nothing scrolls sideways. */
  .cards { margin-top: 72px; display: grid; grid-template-columns: 1fr; gap: 56px 16px; }
  .cards > li { min-width: 0; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .cards { grid-template-columns: repeat(4, 1fr); } }
</style>
